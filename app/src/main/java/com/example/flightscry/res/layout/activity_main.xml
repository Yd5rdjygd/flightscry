<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Cartão de informação do voo -->
        <net.skyscanner.backpack.android.card.internal.BpkCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cornerStyle="large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <net.skyscanner.backpack.android.text.internal.BpkText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flight information"
                    style="@style/bpkTextHeading1" />

                <net.skyscanner.backpack.android.text.internal.BpkText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flight number: SKY123" />
            </LinearLayout>
        </net.skyscanner.backpack.android.card.internal.BpkCardView>

        <!-- Cartão de partida -->
        <net.skyscanner.backpack.android.card.internal.BpkCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cornerStyle="large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <net.skyscanner.backpack.android.text.internal.BpkText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Departure"
                    style="@style/bpkTextHeading1" />

                <net.skyscanner.backpack.android.text.internal.BpkText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIS" />

                <net.skyscanner.backpack.android.text.internal.BpkText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:45" />
            </LinearLayout>
        </net.skyscanner.backpack.android.card.internal.BpkCardView>

        <!-- Cartão de chegada -->
        <net.skyscanner.backpack.android.card.internal.BpkCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cornerStyle="large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <net.skyscanner.backpack.android.text.internal.BpkText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arrival"
                    style="@style/bpkTextHeading1" />

                <net.skyscanner.backpack.android.text.internal.BpkText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAD" />

                <net.skyscanner.backpack.android.text.internal.BpkText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:30" />
            </LinearLayout>
        </net.skyscanner.backpack.android.card.internal.BpkCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
